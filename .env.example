# Copy to .env for local development. Never commit real secrets.
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=change-me-in-every-real-environment
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:3000
FRONTEND_BASE_URL=http://localhost:3000

POSTGRES_DB=equra
POSTGRES_USER=equra
POSTGRES_PASSWORD=equra
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Leave empty to use in-process cache (single process only; rate limits not shared).
REDIS_URL=

# inline (no worker needed) | celery (needs worker) | manual
OUTBOX_DISPATCH=inline
EXPOSE_API_DOCS=true
